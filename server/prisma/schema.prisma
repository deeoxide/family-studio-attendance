generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles/types/statuses are plain strings rather than native Postgres enums
// (kept from the original SQLite schema, which has no enum type) so adding a
// value never needs a migration — they're constrained by the zod schemas in
// src/lib and src/routes instead:
//   Role: "EMPLOYEE" | "MANAGER" | "HR" | "ADMIN"
//   LeaveType: "ANNUAL" | "SICK" | "PERSONAL" | "UNPAID"
//   LeaveStatus / CorrectionStatus / OutingStatus: "PENDING" | "APPROVED" | "REJECTED"
//   PayslipStatus: "OPEN" | "PAID"
//   AttendanceLog.type: "CHECK_IN" | "CHECK_OUT"
//   Outing.category: "MEETING" | "CLIENT" | "ERRAND" | "DOCUMENT" | "OTHER"

/// Single workplace geofence + shift rule config. Seeded with one row (Family Studio)
/// but modelled as a table so HR tooling can edit it later without a schema change.
model Office {
  id            String   @id @default(cuid())
  name          String
  addressEn     String
  addressLo     String
  lat           Float
  lng           Float
  radiusM       Int      @default(10)
  shiftStartMin Int      @default(540) // 09:00
  graceEndMin   Int      @default(570) // 09:30 - arrivals after this are late
  shiftEndMin   Int      @default(1080) // 18:00
  lunchStartMin Int      @default(720) // 12:00
  lunchEndMin   Int      @default(810) // 13:30
  workDays      String   @default("1,2,3,4,5") // Mon-Fri, 0=Sun
  updatedAt     DateTime @updatedAt

  attendanceLogs AttendanceLog[]
}

/// Append-only audit trail: one row per successful clock-in / clock-out, with the
/// raw GPS fix and the distance the server computed from it. AttendanceRecord
/// keeps the day's summary (times, late minutes); this keeps the full history for
/// disputes ("the app said I was 23 m away").
model AttendanceLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id])
  type      String // CHECK_IN | CHECK_OUT
  lat       Float
  lng       Float
  distanceM Float // metres from the office, as computed server-side
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  employeeCode String   @unique
  nameEn       String
  nameLo       String
  roleTitleEn  String
  roleTitleLo  String
  initials     String
  role         String   @default("EMPLOYEE")
  basicSalary  Int // LAK, monthly
  otAmount     Int      @default(0) // LAK, current period overtime pay (from approved OT records)
  allowance    Int      @default(0) // LAK, position allowance
  managerId    String?
  manager      User?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerReports")
  createdAt    DateTime @default(now())

  // Personal information. All optional. The employee maintains their own from the
  // Profile screen (except startDate, which HR/Admin set); HR/Admin may edit anyone's,
  // a manager may edit their direct reports'.
  phone         String? // mobile number
  address       String? // home address
  dateOfBirth   String? // YYYY-MM-DD
  startDate     String? // YYYY-MM-DD, date of first employment
  nationalId    String? // ID card / passport number
  bankAccount   String? // bank account number for payroll

  attendance            AttendanceRecord[]
  attendanceLogs        AttendanceLog[]
  attendanceCorrections AttendanceCorrection[] @relation("CorrectionRequester")
  correctionDecisions   AttendanceCorrection[] @relation("CorrectionDecider")
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]         @relation("Requester")
  decisions             LeaveRequest[]         @relation("Decider")
  outings               Outing[]              @relation("OutingRequester")
  outingDecisions       Outing[]              @relation("OutingDecider")
  payslips              Payslip[]
  jobOrders             JobOrder[]
}

/// An employee stepping out during the shift — a client visit, a meeting, an
/// errand, dropping off documents. The person stays checked in; an approved
/// outing counts as worked time, so it never triggers a late mark or a
/// missing-hours deduction. It's a record, not a pay input.
///
///  - EMPLOYEE          → status PENDING, decided by their manager (Approvals tab)
///  - MANAGER/HR/ADMIN  → status APPROVED + autoLogged, HR is informed only
model Outing {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("OutingRequester", fields: [userId], references: [id])
  date        String // YYYY-MM-DD
  fromTime    String // HH:MM, when they leave
  toTime      String // HH:MM, expected return
  category    String // MEETING | CLIENT | ERRAND | DOCUMENT | OTHER
  purpose     String    @default("")
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  autoLogged  Boolean   @default(false) // true = manager/HR/admin self-log, no approval
  decidedById String?
  decidedBy   User?     @relation("OutingDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, date])
}

/// An employee's request to fix a missed or wrong check-in/out for one past day.
/// Approved by their manager, HR, or Admin; on approval the AttendanceRecord is
/// written and late-minutes recomputed. HR/Admin can also edit records directly
/// without a request (see PUT /api/attendance/manual).
model AttendanceCorrection {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("CorrectionRequester", fields: [userId], references: [id])
  date        String // YYYY-MM-DD, the day being corrected
  checkInAt   DateTime? // requested check-in, null to leave unchanged
  checkOutAt  DateTime? // requested check-out, null to leave unchanged
  reason      String    @default("")
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById String?
  decidedBy   User?     @relation("CorrectionDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AttendanceRecord {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  date              String // YYYY-MM-DD, local calendar day
  checkInAt         DateTime?
  checkOutAt        DateTime?
  checkInDistanceM  Float?
  checkOutDistanceM Float?
  lateMinutes       Int       @default(0) // minutes past the grace cutoff, 0 if on time
  createdAt         DateTime  @default(now())

  @@unique([userId, date])
}

model LeaveBalance {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  leaveType String // ANNUAL | SICK | PERSONAL
  year      Int
  totalDays Int

  @@unique([userId, leaveType, year])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("Requester", fields: [userId], references: [id])
  leaveType   String // ANNUAL | SICK | PERSONAL
  fromDate    String // YYYY-MM-DD
  toDate      String // YYYY-MM-DD
  workingDays Int
  reason      String    @default("")
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById String?
  decidedBy   User?     @relation("Decider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Holiday {
  id     String @id @default(cuid())
  date   String // YYYY-MM-DD
  nameEn String
  nameLo String
  noteEn String
  noteLo String
  days   Int    @default(1)
}

model Payslip {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  periodMonth   String // YYYY-MM
  basic         Int
  ot            Int
  allowance     Int
  gross            Int
  sso              Int
  tax              Int
  lateDeduction    Int       @default(0)
  unpaidDeduction  Int       @default(0) // unpaid / over-entitlement leave days taken this period
  net              Int
  half             Boolean   @default(false)
  status        String    @default("OPEN") // OPEN | PAID
  paidAt        DateTime?

  @@unique([userId, periodMonth])
}

/// A work order an employee logs against a client or production — the studio's
/// job tracker. jobOrderNo is generated as JO<seq><MMYY>-<code> (see
/// src/lib/jobOrderNumber.ts): seq is a two-digit count that resets every
/// calendar month and is kept separately per work-type category, MMYY is the
/// month + year the job was opened, and code is 001 for studio-internal work
/// or 002 for external production.
/// EMPLOYEE creates and tracks their own; MANAGER (their direct reports) / HR
/// / ADMIN (everyone) can view and export the roster for frequency stats.
model JobOrder {
  id         String   @id @default(cuid())
  jobOrderNo String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  clientCode String
  workType   String // INTERNAL | EXTERNAL
  task       String
  openDate   String // YYYY-MM-DD
  status     String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  closeDate  String? // YYYY-MM-DD, set when status becomes CLOSED
  createdAt  DateTime @default(now())

  @@index([userId, openDate])
}
