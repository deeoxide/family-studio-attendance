# Local dev: docker-compose's Postgres. Prod: both point at Supabase — see
# README "Production (Supabase)" section for the exact pooled/direct strings.
DATABASE_URL="postgresql://user:password@localhost:5432/attendance"
DIRECT_URL="postgresql://user:password@localhost:5432/attendance"
JWT_SECRET="change-me-in-production"
PORT=4000
# Comma-separated allowed origins in prod, e.g. "https://family-studio-attendance.vercel.app".
# Unset = reflect any origin (fine for local dev, not for prod).
CORS_ORIGIN=

# Supabase — server-side only, never expose SUPABASE_SECRET_KEY to a client.
# Currently unused by src/ (no Supabase Auth/Storage call yet) — keep or
# remove the @supabase/server dependency depending on whether you still plan
# to use it; these 4 vars are otherwise dead config.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SECRET_KEY="sb_secret_xxx"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
